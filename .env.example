# Local prototype only. VITE_ values are bundled into browser code.
# Never use a production Gemini key in this frontend configuration.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.6-flash

# Ollama Cloud calls are proxied by Vite so this key stays out of browser code.
OLLAMA_API_KEY=
VITE_OLLAMA_MODEL=gpt-oss:120b
VITE_OLLAMA_API_URL=/ollama/v1/chat/completions

# Groq Cloud calls are proxied by Vite so this key stays out of browser code.
GROQ_API_KEY=
VITE_GROQ_MODEL=openai/gpt-oss-120b

# Optional profile labels displayed in the workspace.
VITE_PROFILE_NAME=Your Name
VITE_PROFILE_EMAIL=you@example.com

